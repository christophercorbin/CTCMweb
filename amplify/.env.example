# Amplify backend environment variables
# Most values are injected automatically by Amplify via the execution role and
# amplify_outputs.json. The vars below are read by backend.ts at CDK synth time
# and passed through to the relevant Lambdas — they MUST be set in the Amplify
# Console (Hosting → Environment variables) for each deployed branch.

# ── USER_POOL_ID ──────────────────────────────────────────────────────────────
# Pinned Cognito user pool ID. Used by:
#   - adminCreateCustomer  (create Cognito user + DB record)
#   - adminDeleteCustomer  (delete Cognito user + DB record)
#   - syncCustomers        (list Cognito users and backfill DB)
#
# Without this set, those Lambdas fall back to ListUserPools at runtime and
# pick by name pattern — works, but slower and fragile if the account has
# multiple pools.
#
# Branch pool IDs:
#   develop → us-east-1_YfQ4BVEry
#   main    → TBD
#
# For local sandbox: DO NOT set this to the develop/main pool. Either leave it
# unset (auto-discovers the sandbox-generated pool) or export your own
# sandbox pool ID: `USER_POOL_ID=<sandbox-pool> npx ampx sandbox`.
# USER_POOL_ID=us-east-1_YfQ4BVEry

# ── APP_URL ───────────────────────────────────────────────────────────────────
# Used in outbound emails (welcome email, status notifications) for login links.
#   develop → https://develop.d1yo6c4008x99n.amplifyapp.com
#   main    → https://cargolinkbarbados.com
# APP_URL=https://develop.d1yo6c4008x99n.amplifyapp.com

# ── Misc ──────────────────────────────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=404875533723
# AMPLIFY_APP_ID=<your-amplify-app-id>   # GitHub Actions pipeline-deploy secret
