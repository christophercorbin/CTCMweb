# Amplify backend environment variables
# These are injected automatically by Amplify via the execution role and
# amplify_outputs.json — no manual configuration is required for Lambda functions.
#
# For local sandbox use:
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=404875533723
#
# For pipeline deploys (GitHub Actions secret):
# AMPLIFY_APP_ID=<your-amplify-app-id>
