# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.lcov
.nyc_output

# Production builds
dist/
build/
*.tsbuildinfo

# Environment variables — ignore all .env variants except the examples
.env*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# CDK
cdk.out/
infra/cdk.context.json
*.js.map

# Amplify sandbox artifacts (root-level — amplify/.gitignore only covers amplify/.amplify/)
.amplify/

# Vite config-load temp files (left behind by crashed dev servers)
*.timestamp-*.mjs

# AWS
.aws-sam/
samconfig.toml

# Amplify — generated per-branch by pipeline-deploy, never commit
amplify_outputs.json

# Temporary files
*.tmp
*.temp
.cache/

# OS
Thumbs.db
.DS_Store

# Supabase (legacy - no longer used)
.supabase/

# Claude Code worktrees — never commit these (and never let them be staged
# as gitlinks, which breaks actions/checkout's post-cleanup with "no submodule
# mapping found" exit 128).
.claude/worktrees/
